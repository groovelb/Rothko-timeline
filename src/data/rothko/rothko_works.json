    "periods": [
      {
        "id": "FIG",
        "label": "구상기 (Figurative)",
        "range": "1924–1940",
        "color_tendency": "탁한 갈색, 회색, 어두운 도시 팔레트"
      },
      {
        "id": "MYTH",
        "label": "신화/초현실기 (Mythomorphic)",
        "range": "1940–1946",
        "color_tendency": "회갈색, 적갈색, 몽환적 톤"
      },
      {
        "id": "MULTI",
        "label": "멀티폼 전환기 (Multiforms)",
        "range": "1946–1949",
        "color_tendency": "색이 밝아지기 시작, 다색 덩어리"
      },
      {
        "id": "CLASSIC_B",
        "label": "클래식 밝은 시기 (Classic Bright)",
        "range": "1949–1957",
        "color_tendency": "오렌지, 옐로우, 레드, 핑크 — 따뜻하고 발광하는 색"
      },
      {
        "id": "SEAGRAM",
        "label": "시그램 벽화 (Seagram Murals)",
        "range": "1958–1959",
        "color_tendency": "마룬, 다크 레드, 블랙 — 급격한 어두움 전환"
      },
      {
        "id": "DARK",
        "label": "후기 어두운 시기 (Dark Period)",
        "range": "1960–1967",
        "color_tendency": "다크 퍼플, 블랙, 브라운, 짙은 블루"
      },
      {
        "id": "FINAL",
        "label": "최후기 (Final Works)",
        "range": "1968–1970",
        "color_tendency": "블랙, 그레이, 브라운 — 색의 극단적 환원"
      }
    ],
    "total_known_works": {
      "canvas": 843,
      "works_on_paper": 2600,
      "source": "David Anfam, Catalogue Raisonné (1998) & NGA Works on Paper project"
    }
